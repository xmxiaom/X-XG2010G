diff --git a/ucode/template/themes/argon/footer_login.ut b/ucode/template/themes/argon/footer_login.ut
index e213006..0482b40 100644
--- a/ucode/template/themes/argon/footer_login.ut
+++ b/ucode/template/themes/argon/footer_login.ut
@@ -19,14 +19,26 @@
 </div>
 {%
 	const luci_info = 'Powered by ' + version.luciname + ' (' + version.luciversion + ')';
-	const firmware_info = version.distname + ' ' + version.distversion + '-' + version.distrevision;
+
+	/* 逐段兜底：任一字段缺失时原写法会拼出 "null null-null" */
+	const dist_name = (type(version.distname) == 'string' && version.distname != 'null') ? version.distname : '';
+	const dist_ver = (type(version.distversion) == 'string' && version.distversion != 'null') ? version.distversion : '';
+	const dist_rev = (type(version.distrevision) == 'string' && version.distrevision != 'null') ? version.distrevision : '';
+	const dist_url = (type(version.disturl) == 'string' && length(version.disturl)) ? version.disturl : 'https://github.com/xmxiaom/X-XG2010G';
+
+	let fw = dist_name;
+	if (length(fw) && length(dist_ver)) fw += ' ' + dist_ver;
+	if (length(fw) && length(dist_rev)) fw += '-' + dist_rev;
+	if (!length(fw)) fw = 'ImmortalWrt';
+
+	const firmware_info = fw;
 %}
 <footer>
 	<div class="login-footer-links">
 		<a href="https://github.com/openwrt/luci" target="_blank" title="{{ entityencode(luci_info, true) }}">{{ split(version.luciname, ' (')[0] }}</a>
 		<a href="https://github.com/jerrykuku/luci-theme-argon" target="_blank">ArgonTheme {# vPKG_VERSION #}</a>
 	</div>
-	<a href="{{ version.disturl }}" target="_blank" title="{{ entityencode(firmware_info, true) }}">{{ firmware_info }}</a>
+	<a href="{{ dist_url }}" target="_blank" title="{{ entityencode(firmware_info, true) }}">{{ firmware_info }}</a>
 </footer>
 </main>
 </div>
