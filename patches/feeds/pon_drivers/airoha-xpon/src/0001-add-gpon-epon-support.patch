+#define AIROHA_GPON_TX_FCS_TABLE_INITIALIZATION_CONTROL      0x0100 /* TX FCS TABLE INITIALIZATION CONTROL */
+#define AIROHA_GPON_MIB_CONTROL_STATUS                       0x0120 /* MIB CONTROL AND STATUS */
