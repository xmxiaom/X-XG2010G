+/**
+ * airoha_xpon_scu_rstctrl1_clear - 清除 SCU 复位控制寄存器 1 的位
+ */
+static void airoha_xpon_scu_rstctrl1_clear(struct airoha_xpon *xpon, u32 bits)
+{
+	if (!xpon->scu)
+		return;
+
+	regmap_clear_bits(xpon->scu, AIROHA_GPON_SCU_RSTCTRL1, bits);
