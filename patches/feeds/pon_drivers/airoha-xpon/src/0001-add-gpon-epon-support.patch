+/*
+ * 对应原厂 eponMacRestart（@0x31a80，260B）。
+ *
+ * 原厂调用链（从 xpon.ko 符号表追踪，见 docs/22 第 3 节）：
+ *   eponSetPonMacAddr            → eponMacRestart
+ *   eponWanResetWithChannelRetire → eponMacRestart
+ *   eponMacRestart → eponMacSwReset → xmcs_remove_llid
+ *                  → eponHwDygaspCtrl → eponTxOamFavorModeCtl
+ *                  → eponSnifferModeCtrl
+ *
+ * 注意 eponMacSwReset 只在「停止 / 重启」路径，不在启动路径：
+ *   xpondrv_init → eponInit → eponStart   （启动，不碰 SwReset）
+ *
+ * 所以本函数不能塞进 start_rx，必须作为独立的重启路径，
+ * 在改 MAC 地址或 WAN 重置之后调用。
+ */
+int airoha_xpon_epon_restart_mac(struct airoha_xpon *xpon)
+{
+	int ret;
+
+	if (!xpon->epon_base)
+		return -ENODEV;
+
+	/*
+	 * 1. 软复位：清运行时状态（中断状态、队列计数、错误计数器），
+	 *    保留 MAC 地址、TRX 校准、中断使能等关键配置。
+	 *    对应原厂 eponMacSwReset 的寄存器重配部分。
+	 */
+	ret = airoha_epon_hw_soft_reset(xpon);
+	if (ret)
+		return ret;
+
+	/*
+	 * 2. 清 LLID 注册状态（原厂 xmcs_remove_llid）。
+	 *    重启后必须重新走 MPCP 发现流程。
+	 */
+	airoha_xpon_epon_reset_registration(xpon);
+
+	/*
+	 * 3. 重新启动 MAC（含完整初始化表 + SCU 复位序列）。
+	 *    这一步会重新应用 349 条表并重新 program_mac。
+	 */
+	ret = airoha_xpon_epon_start_mac(xpon);
+	if (ret) {
+		xpon->last_start_error = ret;
+		return ret;
+	}
+
+	dev_info(xpon->dev, "EPON MAC restarted (MAC address change or WAN reset)\n");
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_epon_restart_mac);
