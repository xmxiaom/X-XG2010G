+/**
+ * airoha_xpon_gpon_connection_up - 连接建立完成
+ * @xpon: XPON 设备
+ *
+ * 原厂逻辑：
+ *   1. 已在连接态则直接返回
+ *   2. 走退避计数，未到周期则返回
+ *   3. 上报 xmcs_report_event（GPON 是 event 5）
+ *   4. 把模式字段改成 auto
+ */
+void airoha_xpon_gpon_connection_up(struct airoha_xpon *xpon)
+{
+	const struct airoha_xpon_proto_ops *ops;
+	struct airoha_gpon_priv *priv;
+	bool recovered;
+
+	if (xpon->gpon_link_up)
+		return;
+
+	if (!airoha_xpon_gpon_backoff_ok(xpon))
+		return;
+
+	priv = gpon_priv(xpon);
+	recovered = priv && priv->operational_once;
+
+	xpon->gpon_link_up = true;
+	if (priv)
+		priv->operational_once = true;
+
+	/*
+	 * 掉线重连：OLT 重新分配 ONU-ID 后，MAC 复位已清空 Alloc-ID /
+	 * GEM 表，用备份表恢复业务面是秒级，比等 OMCI 重下一轮
+	 * （30–60 秒）快得多。首次上线不做——那时 GEM 还没建立，
+	 * 由 OMCI 正常下发即可。
+	 */
+	if (recovered) {
+		ops = airoha_xpon_proto(xpon);
+		if (ops && ops->recover && ops->recover(xpon))
+			dev_dbg(xpon->dev,
+				"GPON GEM recovery unavailable or incomplete\n");
+	}
+
+	/* TODO: 上游对应 airoha_xpon_report_event(xpon, 5, 0) */
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_gpon_connection_up);
