+#define AIROHA_GPON_FLEXIBLE_ONU_CAPABILITY_SETTING          0x0200 /* FLEXIBLE ONU CAPABILITY SETTING */
+#define AIROHA_GPON_UPSTREAM_PREFETCH_DATA_OFFSET            0x0204 /* UPSTREAM PREFETCH DATA OFFSET */
