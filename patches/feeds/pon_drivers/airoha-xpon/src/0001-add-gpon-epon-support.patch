+/* GPON PLOAM Password（0x05）的应答内容：10 字节 ASCII，不足补 0。
+ * "default" 恢复为未配置（回全 0）。0600 与身份属性同级保护。 */
+static ssize_t gpon_sn_passwd_show(struct device *dev,
+                                   struct device_attribute *attr, char *buf)
+{
+	struct airoha_xpon *xpon = dev_get_drvdata(dev);
+	const char *pwd = airoha_xpon_gpon_sn_passwd(xpon);
+
+	if (!pwd)
+		return sysfs_emit(buf, "default-zero\n");
+	return sysfs_emit(buf, "%s\n", pwd);
+}
+
+static ssize_t gpon_sn_passwd_store(struct device *dev,
+                                    struct device_attribute *attr,
+                                    const char *buf, size_t count)
+{
+	struct airoha_xpon *xpon = dev_get_drvdata(dev);
+	size_t len = airoha_xpon_trimmed_length(buf, count);
+	int ret;
+
+	if (sysfs_streq(buf, "default")) {
+		ret = airoha_xpon_gpon_set_sn_passwd(xpon, NULL, 0);
+		if (ret)
+			return ret;
+		return count;
+	}
+
+	ret = airoha_xpon_gpon_set_sn_passwd(xpon, buf, len);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR(gpon_sn_passwd, 0600, gpon_sn_passwd_show,
+                   gpon_sn_passwd_store);
