--- a/airoha-xpon/src/airoha-xpon-main.c
+++ b/airoha-xpon/src/airoha-xpon-main.c
@@ -112,6 +112,12 @@
 	if (!mode || !mode->mac_supported)
 		return -EOPNOTSUPP;
 
+	/* 离开 EPON 后，释放 EPON logic reset（SCU SSR3[10]）。
+	 * epon_stop_rx 会置位该位，若不清除，PON MAC 寄存器域无响应，
+	 * 写 XG-PON MAC 的 INT_ENABLE 会卡死 CPU 并触发硬件看门狗复位。
+	 */
+	if (xpon->scu)
+		regmap_clear_bits(xpon->scu, 0x94, BIT(10));
 	ret = airoha_pon_frontend_set_tx_enable(xpon->frontend, false);
 	if (ret)
 		return ret;
